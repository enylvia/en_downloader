{
  "manifest_version": 3,
  "name": "EnylviaDownloader - Edge Integration",
  "version": "1.0.0",
  "description": "Integrasi download manager EnylviaDownloader untuk Microsoft Edge. Multi-connection range downloading berkecepatan tinggi.",
  "key": "",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "nativeMessaging",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:4242/*",
    "http://localhost:4242/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EnylviaDownloader"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
